          "rawSql": "SELECT movie_id, sum(views) AS views\nFROM cinema.daily_top_movies FINAL\nWHERE metric_date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nGROUP BY movie_id\nORDER BY views DESC\nLIMIT 10"
