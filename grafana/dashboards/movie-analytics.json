    {
      "id": 5,
      "type": "table",
      "title": "Retention cohort heatmap (% of cohort active on day N)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toString(cohort_date) AS Cohort, max(cohort_size) AS Users,\n  if(countIf(day_number = 0) = 0, NULL, round(maxIf(retention_rate, day_number = 0) * 100, 1)) AS `Day 0`,\n  if(countIf(day_number = 1) = 0, NULL, round(maxIf(retention_rate, day_number = 1) * 100, 1)) AS `Day 1`,\n  if(countIf(day_number = 2) = 0, NULL, round(maxIf(retention_rate, day_number = 2) * 100, 1)) AS `Day 2`,\n  if(countIf(day_number = 3) = 0, NULL, round(maxIf(retention_rate, day_number = 3) * 100, 1)) AS `Day 3`,\n  if(countIf(day_number = 4) = 0, NULL, round(maxIf(retention_rate, day_number = 4) * 100, 1)) AS `Day 4`,\n  if(countIf(day_number = 5) = 0, NULL, round(maxIf(retention_rate, day_number = 5) * 100, 1)) AS `Day 5`,\n  if(countIf(day_number = 6) = 0, NULL, round(maxIf(retention_rate, day_number = 6) * 100, 1)) AS `Day 6`,\n  if(countIf(day_number = 7) = 0, NULL, round(maxIf(retention_rate, day_number = 7) * 100, 1)) AS `Day 7`\nFROM cinema.cohort_retention FINAL\nWHERE cohort_date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nGROUP BY cohort_date\nORDER BY cohort_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "gradient"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cohort"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Users"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
