            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "table",
          "rawSql": "SELECT toDateTime(metric_date) AS time,\n  sumIf(value, dimension = 'MOBILE') AS MOBILE,\n  sumIf(value, dimension = 'DESKTOP') AS DESKTOP,\n  sumIf(value, dimension = 'TV') AS TV,\n  sumIf(value, dimension = 'TABLET') AS TABLET\nFROM cinema.daily_metrics FINAL\nWHERE metric_name = 'dau_by_device' AND metric_date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nGROUP BY time\nORDER BY time"
        }
      ],
